<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Кто ты в коде: пиксельный маг, серверный бог или геймдев-гуру?</title>
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/babel-standalone@6.26.0/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
  <div id="root" class="max-w-2xl mx-auto p-6"></div>

  <script type="text/babel">
    const questions = [
      { id: 1, text: "Как тебя зовут, будущий властелин кода?", type: "text" },
      {
        id: 2,
        text: "На чем ты творишь свои шедевры?",
        options: [
          { value: "a", text: "Стационарный ПК — мощь и никаких компромиссов" },
          { value: "b", text: "Ноутбук — кодить можно хоть в кофейне, хоть в кровати" },
          { value: "c", text: "Телефон или планшет — я мобилен, как ниндзя" },
          { value: "d", text: "Все подряд, я хаотичный гений" }
        ]
      },
      {
        id: 3,
        text: "Какой у тебя стаж в кодерском деле?",
        options: [
          { value: "a", text: "Я зеленый, как кнопка 'Hello, World!'" },
          { value: "b", text: "Пробовал кодить, но пока больше багов, чем фич" },
          { value: "c", text: "Уже клепаю простенькие штуки, и мне нравится" },
          { value: "d", text: "Я кодер-бог, осталось только мир захватить" }
        ]
      },
      {
        id: 4,
        text: "Что хочешь накодить в IT?",
        options: [
          { value: "a", text: "Сайты и аппы, от которых пользователи в экстазе" },
          { value: "b", text: "Копаться в данных и заставлять машины думать" },
          { value: "c", text: "Серверы, которые не падают, даже если мир рухнет" },
          { value: "d", text: "Игры или проекты, от которых всех порвет" }
        ]
      },
      {
        id: 5,
        text: "Что тебя цепляет в программировании?",
        options: [
          { value: "a", text: "Делать интерфейсы, от которых глаз не оторвать" },
          { value: "b", text: "Копаться в данных и решать задачи для умников" },
          { value: "c", text: "Строить системы, которые работают как танк" },
          { value: "d", text: "Творить что-то, от чего все офигеют" }
        ]
      },
      {
        id: 6,
        text: "Какой проект зажег бы твой кодерский огонь?",
        options: [
          { value: "a", text: "Сайт с анимациями, как в голливудском блокбастере" },
          { value: "b", text: "Прога для анализа данных или предсказания будущего" },
          { value: "c", text: "Сервер, который держит миллион юзеров и не потеет" },
          { value: "d", text: "Игра, где все будут жить твоими правилами" }
        ]
      },
      {
        id: 7,
        text: "Как ты учишься новым фишкам?",
        options: [
          { value: "a", text: "Хватаю примеры из туториалов и повторяю" },
          { value: "b", text: "Копаю документацию, как археолог" },
          { value: "c", text: "Смотрю видео и делаю, как профи" },
          { value: "d", text: "Кидаюсь в бой и учусь на своих косяках" }
        ]
      },
      {
        id: 8,
        text: "Какой язык или шмотку для кодинга хочешь освоить?",
        options: [
          { value: "a", text: "JavaScript или React — для веб-магии" },
          { value: "b", text: "Python — для данных и нейронок" },
          { value: "c", text: "Go или Docker — для серверов и железа" },
          { value: "d", text: "C# или Unity — для эпичных игр" }
        ]
      },
      {
        id: 9,
        text: "Что для тебя главное в проекте?",
        options: [
          { value: "a", text: "Чтобы юзеры орали от восторга" },
          { value: "b", text: "Чтобы код летал, как ракета" },
          { value: "c", text: "Чтобы все работало, как швейцарские часы" },
          { value: "d", text: "Чтобы проект был как взрыв мозга" }
        ]
      },
      {
        id: 10,
        text: "Код не пашет. Твой план?",
        options: [
          { value: "a", text: "Гуглю готовые ответы, я же не дурак" },
          { value: "b", text: "Копаю документацию и дебагю, как Шерлок" },
          { value: "c", text: "Проверяю каждый шаг, как зануда" },
          { value: "d", text: "Переписываю все, авось сработает" }
        ]
      },
      {
        id: 11,
        text: "Как ты к рутине относишься?",
        options: [
          { value: "a", text: "Фу, я за творчество, а не за нудятину" },
          { value: "b", text: "Терплю, если это ради дела" },
          { value: "c", text: "Автоматизирую, чтобы не париться" },
          { value: "d", text: "Не парюсь, если проект огонь" }
        ]
      },
      {
        id: 12,
        text: "Какие задачи тебе по кайфу?",
        options: [
          { value: "a", text: "Интерфейсы и визуальные плюшки" },
          { value: "b", text: "Алгоритмы и данные — мозговой штурм" },
          { value: "c", text: "Серверы и инфраструктура — железная логика" },
          { value: "d", text: "Игровые механики или дикие идеи" }
        ]
      }
    ];

    const results = {
      a: {
        title: "Фронтенд-разработчик — король пикселей",
        description: "Эй, [Имя]! Ты — рок-звезда интерфейсов! Любишь, когда сайты и аппы выглядят так, что пользователи падают в обморок от восторга.",
        recommendations: [
          "Вали на HTML, CSS, JavaScript, а потом вгрызайся в React или Vue.js.",
          "Разберись с UX/UI, чтобы твои интерфейсы были как конфетка.",
          "Запрыгивай на наш курс «Фронтенд-разработка»!"
        ]
      },
      b: {
        title: "Бэкенд-разработчик — повелитель данных",
        description: "[Имя], ты — мозговой ниндзя! Обожаешь копаться в данных, алгоритмах и сложных задачах.",
        recommendations: [
          "Качай Python и SQL, чтобы базы данных пели под твоим управлением.",
          "Штурмуй алгоритмы и структуры данных — это твой хлеб.",
          "Наш курс «Бэкенд-разработка» превратит тебя в архитектора систем!"
        ]
      },
      c: {
        title: "DevOps-инженер — бог серверов",
        description: "[Имя], ты — железный страж инфраструктуры! Серверы, облака и автоматизация — твое поле боя.",
        recommendations: [
          "Освой Docker, Kubernetes и CI/CD, чтобы серверы боялись твоего имени.",
          "Изучи Go или Python для автоматизации рутины.",
          "Курс «DevOps с нуля» сделает тебя королем инфраструктуры!"
        ]
      },
      d: {
        title: "Геймдев-разработчик — создатель миров",
        description: "[Имя], ты — гений, который творит целые вселенные! Игры, креативные проекты и эпичные идеи — твой конек.",
        recommendations: [
          "Вгрызайся в Unity с C# или Godot — это твой старт.",
          "Разберись с геймдизайном и графикой (Blender, Photoshop).",
          "Курс «Разработка игр» поможет тебе создавать миры, которые взорвут индустрию!"
        ]
      }
    };

    function Quiz() {
      const [currentQuestion, setCurrentQuestion] = React.useState(0);
      const [answers, setAnswers] = React.useState({});
      const [name, setName] = React.useState("");
      const [result, setResult] = React.useState(null);

      const handleAnswer = (value) => {
        setAnswers({ ...answers, [questions[currentQuestion].id]: value });
        if (currentQuestion < questions.length - 1) {
          setCurrentQuestion(currentQuestion + 1);
        } else {
          calculateResult();
        }
      };

      const handleNameSubmit = () => {
        if (name.trim().length > 0) {
          handleAnswer(name.trim());
        }
      };

      const calculateResult = () => {
        const counts = { a: 0, b: 0, c: 0, d: 0 };
        Object.values(answers).forEach(answer => {
          if (answer !== name) counts[answer]++;
        });
        const max = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);
        setResult({ ...results[max], description: results[max].description.replace("[Имя]", name || "Кодер") });
      };

      return (
        <div className="bg-white p-6 rounded-lg shadow-lg">
          <h1 className="text-3xl font-bold text-center mb-6 text-indigo-600">Кто ты в коде: пиксельный маг, серверный бог или геймдев-гуру?</h1>
          {result ? (
            <div>
              <h2 className="text-2xl font-semibold mb-4">{result.title}</h2>
              <p className="mb-4">{result.description}</p>
              <h3 className="text-xl font-semibold mb-2">Как стать легендой:</h3>
              <ul className="list-disc pl-5">
                {result.recommendations.map((rec, index) => (
                  <li key={index}>{rec}</li>
                ))}
              </ul>
            </div>
          ) : (
            <div>
              <h2 className="text-xl font-semibold mb-4">{questions[currentQuestion].text}</h2>
              {questions[currentQuestion].type === "text" ? (
                <div className="flex flex-col space-y-2">
                  <input
                    type="text"
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    className="w-full p-2 border rounded mb-4"
                    placeholder="Введи свое имя"
                  />
                  <button
                    onClick={handleNameSubmit}
                    disabled={name.trim().length === 0}
                    className={`w-full p-3 rounded text-white ${
                      name.trim().length === 0
                        ? "bg-gray-400 cursor-not-allowed"
                        : "bg-indigo-600 hover:bg-indigo-700"
                    }`}
                  >
                    Далее
                  </button>
                </div>
              ) : (
                <div className="space-y-2">
                  {questions[currentQuestion].options.map(option => (
                    <button
                      key={option.value}
                      onClick={() => handleAnswer(option.value)}
                      className="w-full p-3 bg-indigo-100 hover:bg-indigo-200 rounded text-left"
                    >
                      {option.text}
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      );
    }

    ReactDOM.render(<Quiz />, document.getElementById("root"));
  </script>
</body>
</html>
