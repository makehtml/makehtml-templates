<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Кто ты в коде: пиксельный маг, серверный бог или геймдев-гуру?</title>
  <script src="https://cdn.jsdelivr.net/npm/react@18.2.0/umd/react.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/react-dom@18.2.0/umd/react-dom.production.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/babel-standalone@6.26.0/babel.min.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 font-sans">
  <div id="root" class="max-w-2xl mx-auto p-6"></div>

  <script type="text/babel">
    const questions = [
      { id: 1, text: "Как звать тебя, кодер, чей баг эпичен?", type: "text" },
      {
        id: 2,
        text: "На чем код твой рождается?",
        options: [
          { value: "a", text: "ПК — мой трон, где пиксели подчиняются" },
          { value: "b", text: "Ноут — кодю, пока кофе не остыл" },
          { value: "c", text: "Телефон — я ниндзя, кодю в метро" },
          { value: "d", text: "Все подряд, я хаос в плоти" }
        ]
      },
      {
        id: 3,
        text: "Твой уровень в кодерском кунг-фу?",
        options: [
          { value: "a", text: "Нуб, только 'print('Hello, World!') освоил" },
          { value: "b", text: "Баги плодю, но уже не плачу" },
          { value: "c", text: "Серверы мои дрожат от страха" },
          { value: "d", text: "Я хакер из фильмов 90-х" }
        ]
      },
      {
        id: 4,
        text: "Какой кодерский подвиг твой сон?",
        options: [
          { value: "a", text: "Сайт, от которого юзеры в агонии счастья" },
          { value: "b", text: "Нейронка, что умнее моего босса" },
          { value: "c", text: "Сервер, который не ляжет даже в Черную пятницу" },
          { value: "d", text: "Игра, где я — главный босс" }
        ]
      },
      {
        id: 5,
        text: "Что в коде твой кайф?",
        options: [
          { value: "a", text: "Пиксели складывать в шедевр, как Да Винчи" },
          { value: "b", text: "Данные мять, пока они не заплачут" },
          { value: "c", text: "Серверы чинить, как бог железа" },
          { value: "d", text: "Искры креатива, чтобы всех порвало" }
        ]
      },
      {
        id: 6,
        text: "Код глючит. Твой ход?",
        options: [
          { value: "a", text: "Гуглю, пока Stack Overflow не сдастся" },
          { value: "b", text: "Дебажу, как Шерлок с лупой" },
          { value: "c", text: "Логами завалю, найду гада" },
          { value: "d", text: "Перепишу всё, я же гений" }
        ]
      },
      {
        id: 7,
        text: "Какой инструмент твой вайб?",
        options: [
          { value: "a", text: "React — верчу пиксели, как хочу" },
          { value: "b", text: "Python — данные мои рабы" },
          { value: "c", text: "Docker — сервера в коробке" },
          { value: "d", text: "Unity — миры мои, юзеры в шоке" }
        ]
      },
      {
        id: 8,
        text: "Рутина в коде — твой враг?",
        options: [
          { value: "a", text: "Фу, я за красоту, а не за скуку" },
          { value: "b", text: "Терплю, если данные вкусные" },
          { value: "c", text: "Всё, что может быть автоматизировано — должно быть автоматизировано" },
          { value: "d", text: "Не замечаю, если код как триллер" }
        ]
      }
    ];

    const results = {
      a: {
        title: "Пиксельный маг — фронтенд-рокстар",
        description: "О, [Имя]! Ты чародей интерфейсов, от твоих сайтов юзеры теряют дар речи. CSS — твой посох, React — твой меч!",
        recommendations: [
          "Гони за HTML, CSS, JavaScript, потом вгрызайся в React.",
          "UX/UI — твой следующий лвл, чтобы рвать всех.",
          "Наш курс «Фронтенд» — твой билет в пиксельный рай!"
        ]
      },
      b: {
        title: "Данные-повелитель — бэкенд-ниндзя",
        description: "[Имя], ты укротитель данных! Алгоритмы трепещут, базы данных молят о пощаде. Python — твой катана.",
        recommendations: [
          "Качай Python и SQL, базы будут петь тебе оды.",
          "Алгоритмы — твой дзен, вгрызайся в них.",
          "Курс «Бэкенд» — и ты бог серверов!"
        ]
      },
      c: {
        title: "Серверный бог — DevOps-титан",
        description: "[Имя], ты страж железа! Серверы работают, потому что боятся твоего гнева. Docker — твой молот Тора.",
        recommendations: [
          "Docker, Kubernetes, CI/CD — твое оружие.",
          "Python или Go для автоматизации — и ты непобедим.",
          "Курс «DevOps» — стань владыкой облаков!"
        ]
      },
      d: {
        title: "Геймдев-гуру — создатель хаоса",
        description: "[Имя], ты творишь миры, где юзеры теряют рассудок! Игры и креатив — твой космос, Unity — твой корабль.",
        recommendations: [
          "Unity и C# — твой старт в эпичные миры.",
          "Геймдизайн и Blender — для взрыва мозга.",
          "Курс «Геймдев» — и твоя игра порвет чарты!"
        ]
      }
    };

    function Quiz() {
      const [currentQuestion, setCurrentQuestion] = React.useState(0);
      const [answers, setAnswers] = React.useState({});
      const [name, setName] = React.useState("");
      const [result, setResult] = React.useState(null);

      const handleAnswer = (value) => {
        setAnswers({ ...answers, [questions[currentQuestion].id]: value });
        if (currentQuestion < questions.length - 1) {
          setCurrentQuestion(currentQuestion + 1);
        } else {
          calculateResult();
        }
      };

      const handleNameSubmit = () => {
        if (name.trim().length > 0) {
          handleAnswer(name.trim());
        }
      };

      const calculateResult = () => {
        const counts = { a: 0, b: 0, c: 0, d: 0 };
        Object.values(answers).forEach(answer => {
          if (answer !== name) counts[answer]++;
        });
        const max = Object.keys(counts).reduce((a, b) => counts[a] > counts[b] ? a : b);
        setResult({ ...results[max], description: results[max].description.replace("[Имя]", name || "Кодер") });
      };

      return (
        <div className="bg-white p-6 rounded-lg shadow-lg">
          <h1 className="text-3xl font-bold text-center mb-6 text-indigo-600">Твой кодерский вайб: фронтенд-рокер, бэкенд-гуру или повелитель серверов?</h1>
          {result ? (
            <div>
              <h2 className="text-2xl font-semibold mb-4">{result.title}</h2>
              <p className="mb-4">{result.description}</p>
              <h3 className="text-xl font-semibold mb-2">Как стать легендой:</h3>
              <ul className="list-disc pl-5">
                {result.recommendations.map((rec, index) => (
                  <li key={index}>{rec}</li>
                ))}
              </ul>
            </div>
          ) : (
            <div>
              <h2 className="text-xl font-semibold mb-4">{questions[currentQuestion].text}</h2>
              {questions[currentQuestion].type === "text" ? (
                <div className="flex flex-col space-y-2">
                  <input
                    type="text"
                    value={name}
                    onChange={(e) => setName(e.target.value)}
                    className="w-full p-2 border rounded mb-4"
                    placeholder="Введи свое имя"
                  />
                  <button
                    onClick={handleNameSubmit}
                    disabled={name.trim().length === 0}
                    className={`w-full p-3 rounded text-white ${
                      name.trim().length === 0
                        ? "bg-gray-400 cursor-not-allowed"
                        : "bg-indigo-600 hover:bg-indigo-700"
                    }`}
                  >
                    Далее
                  </button>
                </div>
              ) : (
                <div className="space-y-2">
                  {questions[currentQuestion].options.map(option => (
                    <button
                      key={option.value}
                      onClick={() => handleAnswer(option.value)}
                      className="w-full p-3 bg-indigo-100 hover:bg-indigo-200 rounded text-left"
                    >
                      {option.text}
                    </button>
                  ))}
                </div>
              )}
            </div>
          )}
        </div>
      );
    }

    ReactDOM.render(<Quiz />, document.getElementById("root"));
  </script>
</body>
</html>
